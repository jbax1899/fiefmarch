{
  "name": "fiefmarch-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:client": "pnpm --filter @fiefmarch/client dev",
    "dev:server": "pnpm --filter @fiefmarch/server dev",
    "build": "pnpm --filter @fiefmarch/client build && pnpm --filter @fiefmarch/server build",
    "typecheck": "pnpm --filter @fiefmarch/game typecheck && pnpm --filter @fiefmarch/client typecheck && pnpm --filter @fiefmarch/server typecheck",
    "lint": "eslint apps packages",
    "test": "pnpm --filter @fiefmarch/game test && pnpm --filter @fiefmarch/server test",
    "smoke:server": "pnpm --filter @fiefmarch/server smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
